{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cafestartups.local/schemas/demand-card.schema.json",
  "title": "Cafe Startups Demand Card",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "row", "quantity", "icons", "source"],
  "properties": {
    "id": { "type": "string" },
    "row": { "enum": ["ordinary", "advanced"] },
    "quantity": { "type": "integer", "enum": [1, 2] },
    "icons": {
      "type": "array",
      "items": { "enum": ["coffee", "dessert", "beans", "taste", "service", "price"] }
    },
    "source": { "enum": ["mvp-fixture", "rulebook-verified"] }
  },
  "allOf": [
    {
      "if": { "properties": { "row": { "const": "ordinary" } } },
      "then": { "properties": { "quantity": { "const": 1 }, "icons": { "minItems": 1, "maxItems": 1 } } }
    },
    {
      "if": { "properties": { "row": { "const": "advanced" } } },
      "then": { "properties": { "quantity": { "const": 2 }, "icons": { "minItems": 2, "maxItems": 2 } } }
    }
  ]
}
